{
  "name": "markdown-viewer",
  "version": "1.0.0",
  "description": "Markdown Viewer with KaTeX, Mermaid, Plotly",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --ia32"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.markdownviewer",
    "productName": "MarkdownViewer",
    "directories": { "output": "dist" },
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    }
  }
}